{
  "manifest_version": 3,
  "name": "arkadia_treningi",
  "version": "1.0.0",
  "description": "Kalkulator kosztow treningu umiejetnosci dla oficjalnego klienta arkadia.rpg.pl",
  "content_scripts": [
    {
      "matches": [
        "https://arkadia.rpg.pl/*"
      ],
      "js": [
        "treningi.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://arkadia.rpg.pl/*",
    "https://isithunzi000.github.io/*"
  ]
}
